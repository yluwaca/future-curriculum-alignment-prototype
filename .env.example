# Copy to .env and replace every CHANGE_ME value before starting.
COMPOSE_PROJECT_NAME=future_prototype
POSTGRES_DB=future
POSTGRES_USER=future
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
HTTP_PORT=8080
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
ENVIRONMENT=examiner
DATABASE_SSL_MODE=disable
